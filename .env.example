# Kişisel Sabah Bülteni — örnek yapılandırma. Bu dosyayı .env olarak kopyalayın ve doldurun.
# .env dosyasını asla depoya eklemeyin (sırlar içerir).

# --- Uygulama ---------------------------------------------------------------
DATA_DIR=./data
# Uygulamaya dışarıdan erişilecekse ZORUNLU: güçlü bir parola ve rastgele bir anahtar.
APP_PASSWORD=
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# E-posta/Telegram bağlantılarında kullanılacak genel adres (ters proxy arkasında https://…)
APP_BASE_URL=http://localhost:8000
DEFAULT_TIMEZONE=Europe/Istanbul
# Toplama aralığı (dakika); bülten saatinden 25 dk önce ayrıca toplama yapılır.
COLLECT_INTERVAL_MIN=180

# --- Telegram ----------------------------------------------------------------
# @BotFather ile bot oluşturun; token'ı buraya yazın. Sohbet kimliğini arayüzden girin (bota /start yazın).
TELEGRAM_BOT_TOKEN=
# polling (genel URL gerekmez) | webhook | off
TELEGRAM_MODE=polling
# webhook modunda: https://ALANADI/telegram/webhook/<bu-değer> ve aynı değer secret_token olarak
TELEGRAM_WEBHOOK_SECRET=

# --- E-posta (SMTP) -------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- LLM (özetleme) ------------------------------------------------------------
# anthropic | openai_compat | none   (none: AI'sız şablon özet)
LLM_PROVIDER=none
# Anthropic için varsayılan: claude-opus-5. Daha düşük maliyet için claude-sonnet-5 veya claude-haiku-4-5
# seçebilirsiniz (fiyatları aşağıdaki LLM_PRICE_* değerlerine yansıtın).
LLM_MODEL=
ANTHROPIC_API_KEY=
# low | medium | high  (özetleme için medium yeterli)
LLM_EFFORT=medium
# Claude Opus 5 için sunucu tarafı yedek model: default | off
LLM_FALLBACKS=default
# OpenAI uyumlu uç nokta (Claude dışı sağlayıcılar veya yerel model; ör. http://ollama:11434/v1)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# Günlük bütçe ve çağrı sınırı (aşılırsa şablon özete düşülür)
LLM_DAILY_BUDGET_USD=1.00
LLM_MAX_CALLS_PER_DAY=60
# Maliyet tahmini için model fiyatı (USD / 1M token). claude-opus-5: 5 / 25
LLM_PRICE_IN_PER_MTOK=5
LLM_PRICE_OUT_PER_MTOK=25

# --- Web araması (yeni saha raporlarını keşif) ---------------------------------------
# brave | searxng | none
SEARCH_PROVIDER=none
BRAVE_API_KEY=
# Kendi SearXNG örneğiniz (JSON çıktısı açık olmalı), ör. http://searxng:8080
SEARXNG_URL=
SEARCH_DAILY_LIMIT=30

# --- Reddit Data API (r/sysadmin, r/Intune, r/SCCM saha sinyalleri) -----------------------
# Reddit'in robots.txt dosyası RSS okumaya izin vermediği için Reddit yalnızca resmî Data API ile okunur.
# https://www.reddit.com/prefs/apps adresinde "script" türünde bir uygulama oluşturun (Reddit'in güncel
# Data API koşullarını ve kayıt sürecini kontrol edin). Yalnızca uygulama erişimi (client credentials)
# kullanılır: Reddit parolanız gerekmez ve istenmez.
# Boş bırakılırsa Reddit kaynakları kapalı kalır ve "yapılandırılmadı" olarak raporlanır.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit API kuralı: açıklayıcı User-Agent, biçim: <platform>:<uygulama kimliği>:<sürüm> (by /u/<kullanıcı adı>)
# Örnek: linux:kisisel-sabah-bulteni:v0.1.0 (by /u/kullaniciadiniz)   (yalnızca ASCII)
REDDIT_USER_AGENT=
# REDDIT_USER_AGENT boşsa bu kullanıcı adıyla yukarıdaki biçimde bir User-Agent oluşturulur.
REDDIT_USERNAME=

# --- Veri sağlayıcıları --------------------------------------------------------------
OPEN_METEO_BASE=https://api.open-meteo.com
OPEN_METEO_GEOCODING_BASE=https://geocoding-api.open-meteo.com
TCMB_URL=https://www.tcmb.gov.tr/kurlar/today.xml
TRUNCGIL_URL=https://finans.truncgil.com/today.json
# Kendi piyasa kaynağınız (isteğe bağlı): JSON adresi ve alan eşlemesi
# Örnek eşleme: {"time":"meta.updated","items":{"BILEZIK22":{"buy":"bilezik22.alis","sell":"bilezik22.satis","workmanship":"dahil"}}}
MARKET_JSON_URL=
MARKET_JSON_MAPPING=
# YouTube transkriptleri (youtube-transcript-api paketi gerekir; varsayılan kapalı)
YOUTUBE_TRANSCRIPTS=false

# --- Ağ ---------------------------------------------------------------------------
HTTP_TIMEOUT=25
# Yalnızca ASCII karakter
HTTP_USER_AGENT=KisiselSabahBulteni/0.1 (+single-user personal morning bulletin)
# Özel ağ kontrolünden muaf tutulacak ana bilgisayarlar (yalnızca operatör; ör. iç SearXNG)
TRUSTED_FETCH_HOSTS=
