[Unit]
Description=Kişisel Sabah Bülteni - web arayüzü
After=network-online.target
Wants=network-online.target

[Service]
User=bulten
WorkingDirectory=/opt/bulten
EnvironmentFile=/opt/bulten/.env
ExecStart=/opt/bulten/.venv/bin/bulten web --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/bulten/data

[Install]
WantedBy=multi-user.target
